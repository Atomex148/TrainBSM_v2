<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\**" />
    <EmbeddedResource Remove="Assets\**" />
    <None Remove="Assets\**" />
    <Page Remove="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="AppAppearance\Assets\cooling_frame\snowflake.png" />
    <None Remove="AppAppearance\Assets\cooling_frame\snowflake_indocator_off.png" />
    <None Remove="AppAppearance\Assets\cooling_frame\snowflake_indocator_on.png" />
    <None Remove="AppAppearance\Assets\fire_emergency\fire_shield.png" />
    <None Remove="AppAppearance\Assets\fire_emergency\flame_off.png" />
    <None Remove="AppAppearance\Assets\fire_emergency\flame_on.png" />
    <None Remove="AppAppearance\Assets\traction_frame\traction.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppAppearance\Assets\cooling_frame\snowflake.png" />
    <Resource Include="AppAppearance\Assets\cooling_frame\snowflake_indocator_off.png" />
    <Resource Include="AppAppearance\Assets\cooling_frame\snowflake_indocator_on.png" />
    <Resource Include="AppAppearance\Assets\engine_control\engine.png" />
    <Resource Include="AppAppearance\Assets\fire_emergency\fire_shield.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="AppAppearance\Assets\fire_emergency\flame_off.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="AppAppearance\Assets\fire_emergency\flame_on.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="AppAppearance\Assets\traction_frame\traction.png" />
  </ItemGroup>

</Project>
