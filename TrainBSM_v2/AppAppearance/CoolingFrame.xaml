<UserControl x:Class="TrainBSM_v2.AppAppearance.CoolingFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainBSM_v2.AppAppearance"
             xmlns:new_controls="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d" 
             d:DesignHeight="723" d:DesignWidth="1008">

    <Grid x:Name="MainGrid" Background="#FFE8E8E8" Margin="8" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Охлаждение" FontWeight="Bold" 
                   FontSize="40"/>

        <Grid Grid.Row="1">
            <Grid HorizontalAlignment="Left" Width="500" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <new_controls:DiscreteIndicator x:Name="cool_flt_ohlazhdeniya_bog_r_1_ind" 
                                    Grid.Row="0" Margin="5" LabelMargin="30" LabelText="Неисправность охлаждения тележка 1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_flt_ohlazhdeniya_bog_r_2_ind" 
                                    Grid.Row="1" Margin="5" LabelMargin="30" LabelText="Неисправность охлаждения тележка 2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_flt_ohlazhdeniya_dsl_r_ind"
                                    Grid.Row="2" Margin="5" LabelMargin="30" LabelText="Неисправность охлаждения дизеля"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_flt_ohlazhdeniya_rect_ind"
                                    Grid.Row="3" Margin="5" LabelMargin="30" LabelText="Неисправность охлаждения выпрямителя"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_ena_ohlazhdeniya_bog_1_ind"
                                    Grid.Row="4" Margin="5" LabelMargin="30" LabelText="Включение охлаждения тележка 1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_ena_ohlazhdeniya_bog_2_ind"
                                    Grid.Row="5" Margin="5" LabelMargin="30" LabelText="Включение охлаждения тележка 2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_ena_ohlazhdeniya_dsl_ind"
                    Grid.Row="6" Margin="5" LabelMargin="30" LabelText="Включение охлаждения дизеля"
                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>

                <new_controls:DiscreteIndicator x:Name="cool_ena_ohlazhdeniya_rect_ind"
                    Grid.Row="7" Margin="5" LabelMargin="30" LabelText="Включение охлаждения выпрямителя"
                    HorizontalAlignment="Left" VerticalAlignment="Center" UseImage="True" 
                    ActiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_on.png"
                    InactiveImageSource="/AppAppearance/Assets/cooling_frame/snowflake_indocator_off.png"/>
            </Grid>
        </Grid>
        <Image Height="540" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,84,-278,0" 
               Width="540" Opacity="0.1" Source="/AppAppearance/Assets/cooling_frame/snowflake.png" Grid.RowSpan="2"/>
    </Grid>
</UserControl>
