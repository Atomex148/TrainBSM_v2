<UserControl x:Class="TrainBSM_v2.AppAppearance.TractionFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainBSM_v2.AppAppearance"
             xmlns:new_controls="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d" 
             d:DesignHeight="723" d:DesignWidth="1008">

    <Grid x:Name="MainGrid" Background="#FFE8E8E8" Margin="8" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Тяговой блок" 
                           FontWeight="Bold" FontSize="35"/>

                <Border Grid.Row="1" CornerRadius="5" Background="DarkGray" Margin="10">
                    <Grid>
                        <Image Source="/AppAppearance/Assets/traction_frame/traction.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1" Panel.ZIndex="1"/>

                        <Grid Margin="10" Panel.ZIndex="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <new_controls:SquareGauge x:Name="traction_curr_first_grp_ind" Grid.Column="0" Grid.Row="0" Margin="5,15" 
                                                      IsSignVisible="True" VerticalAlignment="Bottom"
                                                      MinValue="0" MaxValue="1100" LableFontSize="8"
                                                      MajorTicks="12" MinorTicks="3"
                                                      YellowZoneHigh="950" RedZoneHigh="1092"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Ток группы ТЭД №1" 
                                       FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>

                            <new_controls:SquareGauge x:Name="traction_curr_second_grp_ind" Grid.Column="1" Grid.Row="0" Margin="5,15" 
                                                      IsSignVisible="True" VerticalAlignment="Bottom"
                                                      MinValue="0" MaxValue="1100" LableFontSize="8"
                                                      MajorTicks="12" MinorTicks="3" 
                                                      YellowZoneHigh="950" RedZoneHigh="1092"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Ток группы ТЭД №2" 
                                       FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>

                            <new_controls:SquareGauge x:Name="traction_curr_third_grp_ind" Grid.Column="2" Grid.Row="0" 
                                                      Margin="5,15" IsSignVisible="True" VerticalAlignment="Bottom"
                                                      MinValue="0" MaxValue="1100" LableFontSize="8"
                                                      MajorTicks="12" MinorTicks="3"
                                                      YellowZoneHigh="950" RedZoneHigh="1092"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Ток группы ТЭД №3" 
                                       FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" CornerRadius="5" Background="DarkGray" Margin="10">
                    <Grid>
                        <Image Source="/AppAppearance/Assets/traction_frame/traction.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1" Panel.ZIndex="1"/>

                        <Grid Margin="5" Panel.ZIndex="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <new_controls:DiscreteIndicator x:Name="traction_ena_grp_ted_1_ind" Grid.Column="0" Grid.Row="0" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Включение группы ТЭД №1"/>
                            <new_controls:DiscreteIndicator x:Name="traction_ena_grp_ted_2_ind" Grid.Column="1" Grid.Row="0" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Включение группы ТЭД №2"/>
                            <new_controls:DiscreteIndicator x:Name="traction_ena_grp_ted_3_ind" Grid.Column="2" Grid.Row="0" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Включение группы ТЭД №3"/>

                            <new_controls:DiscreteIndicator x:Name="traction_cont_grp_ted_1_ind" Grid.Column="0" Grid.Row="1" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Контактор группы ТЭД №1"/>
                            <new_controls:DiscreteIndicator x:Name="traction_cont_grp_ted_2_ind" Grid.Column="1" Grid.Row="1" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Контактор группы ТЭД №2"/>
                            <new_controls:DiscreteIndicator x:Name="traction_cont_grp_ted_3_ind" Grid.Column="2" Grid.Row="1" 
                                                            Height="35" Margin="5" HorizontalAlignment="Left" LabelText="Контактор группы ТЭД №3"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" CornerRadius="5" Background="DarkGray" Margin="10">
                    <Grid>
                        <Image Source="/AppAppearance/Assets/traction_frame/traction.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1" Panel.ZIndex="1"/>

                        <Grid Margin="0" Panel.ZIndex="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <new_controls:RollingCounter x:Name="traction_volt_trac_gen_ind" Grid.Column="0" Grid.Row="0" Width="270" 
                                                         Margin="8" NumbersCount="6" SensorName="Напряжение тягового генератора"/>
                            <new_controls:RollingCounter x:Name="traction_curr_exc_tg_ind" Grid.Column="1" Grid.Row="0" Width="270" 
                                                         Margin="8" NumbersCount="6" SensorName="Ток возбуждения ТГ"/>
                            <new_controls:RollingCounter x:Name="traction_volt_exc_tg_ind" Grid.Column="0" Grid.Row="1" Width="270" 
                                                         Margin="8" NumbersCount="6" SensorName="Напряжение возбуждения ТГ"/>
                            <new_controls:DiscreteIndicator x:Name="traction_cont_exc_tg_ind" Grid.Column="1" Grid.Row="1" 
                                                            Height="40" Margin="10" LabelText="Контактор возбуждения ТГ"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" CornerRadius="5" Background="DarkGray" Margin="10">
                <Grid>
                    <Image Source="/AppAppearance/Assets/traction_frame/traction.png" Stretch="Uniform" Margin="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1" Panel.ZIndex="1"/>

                    <Grid Margin="10" Panel.ZIndex="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <new_controls:DiscreteIndicator x:Name="traction_train_cont_km1_ind" Grid.Row="0" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен поездной контактор КМ1"/>
                        <new_controls:DiscreteIndicator x:Name="traction_train_cont_km2_ind" Grid.Row="1" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен поездной контактор КМ2"/>
                        <new_controls:DiscreteIndicator x:Name="traction_train_cont_km3_ind" Grid.Row="2" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен поездной контактор КМ3"/>
                        <new_controls:DiscreteIndicator x:Name="traction_cont_fld_shunt_km4_ind" Grid.Row="3" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен контактор шунтировки поля КМ4"/>
                        <new_controls:DiscreteIndicator x:Name="traction_cont_fld_shunt_km5_ind" Grid.Row="4" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен контактор шунтировки поля КМ5"/>
                        <new_controls:DiscreteIndicator x:Name="traction_cont_exc_tg_is_on_ind" Grid.Row="5" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Включен контактор возбуждения ТГ"/>
                        <new_controls:DiscreteIndicator x:Name="traction_cont_shuntirovaniya_fld_1_ind" Grid.Row="6" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left" 
                                                        LabelText="Контактор шунтирования поля 1 степени"/>
                        <new_controls:DiscreteIndicator x:Name="traction_cont_shuntirovaniya_fld_2_ind" Grid.Row="7" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Контактор шунтирования поля 2 степени"/>
                        <new_controls:DiscreteIndicator x:Name="traction_ctl_vozbuzhdeniem_ind" Grid.Row="8" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Сигнал управления возбуждением"/>
                        <new_controls:DiscreteIndicator x:Name="traction_ena_exc_ind" Grid.Row="9" Height="40" 
                                                        Margin="5" HorizontalAlignment="Left"
                                                        LabelText="Сигнал разрешения возбуждения"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>