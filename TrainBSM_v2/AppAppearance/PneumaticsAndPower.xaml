<UserControl x:Class="TrainBSM_v2.AppAppearance.PneumaticsAndPower"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainBSM_v2.AppAppearance"
             xmlns:new_controls="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d" 
             d:DesignHeight="723" d:DesignWidth="1008">
    <Grid x:Name="MainGrid" Background="#FFE8E8E8" Margin="8" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Пневматика и питание" 
                   FontWeight="Bold" FontSize="40"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="5" Background="DarkGray" Margin="10">
                <Grid>
                    <Image Source="/AppAppearance/Assets/pneumatic_and_power/flash.png" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1" Margin="10"/>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <new_controls:SimpleGauge x:Name="power_volt_bortovoi_seti" Grid.Column="0" Grid.Row="0" Margin="5"
                                                  MinValue="0" MaxValue="40" MajorTicks="5" MinorTicks="9" IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                   Text="Напряжение бортовой сети, В" 
                                   FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                        <new_controls:SquareGauge x:Name="power_curr_ab" Grid.Column="1" Grid.Row="0" Margin="5" 
                                                  MinValue="-400" MaxValue="400" MajorTicks="9" IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                   Text="Ток АБ, A" 
                                   FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>

                        <new_controls:SimpleGauge x:Name="power_volt_bortovoi_seti_disel" Grid.Column="2" Grid.Row="0" Margin="5"
                                                  MinValue="0" MaxValue="40" MajorTicks="5" MinorTicks="9" IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                   Text="Напряжение бортовой сети дизеля, В" 
                                   FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                        <new_controls:SquareGauge x:Name="power_curr_ab_disel" Grid.Column="3" Grid.Row="0" Margin="5" 
                                                  MinValue="-400" MaxValue="400" MajorTicks="9" IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                   Text="Ток АБ в цепи дизеля, A" 
                                   FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="5" Background="DarkGray" Margin="10">
                    <Grid>
                        <Image Source="/AppAppearance/Assets/pneumatic_and_power/compressor.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1"/>
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <new_controls:DiscreteIndicator Grid.Row="0" x:Name="compr_ena_compr" Height="120" Margin="5"
                                                            UseImage="True" ActiveImageSource="/AppAppearance/Assets/toggle_switch_on.png"
                                                            InactiveImageSource="/AppAppearance/Assets/toggle_switch_off.png"
                                                            LabelText="Включение компрессора" LabelMargin="20" FontSize="15"
                                                            IsClickable="True" AnimationDuration="0"
                                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            <new_controls:DiscreteIndicator Grid.Row="1" x:Name="compr_ena_privoda_compr" Height="120" Margin="5"
                                                            UseImage="True" ActiveImageSource="/AppAppearance/Assets/toggle_switch_on.png"
                                                            InactiveImageSource="/AppAppearance/Assets/toggle_switch_off.png"
                                                            LabelText="Включение привода компрессора" LabelMargin="20" FontSize="15"
                                                            IsClickable="True" AnimationDuration="0"
                                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            <new_controls:DiscreteIndicator Grid.Row="2" x:Name="compr_datchik_peregreva_oil" Height="80" Margin="5"
                                                            InactiveColor="DarkRed" ActiveColor="Red"
                                                            LabelText="Датчик перегрева масла компрессора" 
                                                            LabelMargin="20" FontSize="15"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" CornerRadius="5" Background="DarkGray" Margin="10">
                    <Grid Margin="10">
                        <Image Source="/AppAppearance/Assets/pneumatic_and_power/pneumatic.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.1"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>

                                <new_controls:ColumnGauge Grid.Column="0" Grid.Row="0" x:Name="pneu_press_v_main"
                                                          MinValue="0" MaxValue="10" MinorTicks="9"
                                                          YellowZoneLow="7.49" YellowZoneHigh="8.51"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Text="Давление в питательной магистрали, бар" 
                                           FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                                
                                <new_controls:ColumnGauge Grid.Column="1" Grid.Row="0" x:Name="pneu_press_v_brk_mag"
                                                          MinValue="0" MaxValue="10" MinorTicks="9"
                                                          YellowZoneHigh="4.51"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Text="Давление в тормозной магистрали, бар" 
                                           FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                                
                                <new_controls:ColumnGauge Grid.Column="2" Grid.Row="0" x:Name="pneu_press_v_brk_cil"
                                                          MinValue="0" MaxValue="10" MinorTicks="9"
                                                          YellowZoneHigh="4.01"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Text="Давление в тормозных цилиндрах, бар" 
                                           FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <new_controls:DiscreteIndicator Grid.Row="0" x:Name="pneu_brk" Height="75" Margin="5"
                                                                InactiveColor="DarkRed" ActiveColor="Red"
                                                                LabelText="Обрыв тормозной магистрали" 
                                                                LabelMargin="20" FontSize="14"/>
                                <new_controls:DiscreteIndicator Grid.Row="1" x:Name="pneu_press_v_brk_cil_dics" Height="75" Margin="5"
                                                                InactiveColor="DarkRed" ActiveColor="Red"
                                                                LabelText="Давление в тормозных цилиндрах" 
                                                                LabelMargin="20" FontSize="14"/>
                                <new_controls:DiscreteIndicator Grid.Row="2" x:Name="pneu_press_v_brk_mag_disc" Height="75" Margin="5"
                                                                InactiveColor="DarkRed" ActiveColor="Red"
                                                                LabelText="Давление в тормозной магистрали" 
                                                                LabelMargin="20" FontSize="14"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
