                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="8" FontSize="36" Height="50" FontWeight="Bold"
                            VerticalAlignment="Center" TextAlignment="Center" Foreground="LimeGreen">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="9" FontSize="36" Height="50" FontWeight="Bold"
                            VerticalAlignment="Center" TextAlignment="Center" Foreground="LimeGreen">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
