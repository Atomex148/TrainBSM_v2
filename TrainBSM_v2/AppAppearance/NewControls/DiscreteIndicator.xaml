<UserControl x:Class="TrainBSM_v2.AppAppearance.NewControls.DiscreteIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d"
             x:Name="RootControl">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" 
                 Stretch="Uniform"
                 StretchDirection="Both">
            <Grid Width="20" Height="20">
                <Ellipse x:Name="LightBulb" Width="20" Height="20" Fill="Green" Stroke="Black" StrokeThickness="1"/>

                <Image x:Name="InactiveImage" Width="20" Height="20" 
                       Visibility="Collapsed" Stretch="Uniform"/>
                <Image x:Name="ActiveImage" Width="20" Height="20" 
                       Visibility="Collapsed" Stretch="Uniform" Opacity="0"/>
            </Grid>
        </Viewbox>

        <Border Grid.Column="1" Width="{Binding LabelMargin, ElementName=RootControl}"/>

        <TextBlock x:Name="Lable" Grid.Column="2" VerticalAlignment="Center"
                   TextWrapping="Wrap" FontWeight="Bold"/>
    </Grid>
</UserControl>