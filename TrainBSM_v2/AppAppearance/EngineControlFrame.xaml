<UserControl x:Class="TrainBSM_v2.AppAppearance.EngineControlFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_controls="clr-namespace:TrainBSM_v2.AppAppearance.Controls"
             xmlns:new_controls="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d" d:DesignHeight="723" d:DesignWidth="1008">
    <Grid>
        <Grid x:Name="MainGrid" Background="#FFE8E8E8" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Image Margin="240,98,240,97" Source="/AppAppearance/Assets/engine_control/engine.png" Stretch="Fill"
                  Opacity="0.1" Grid.ColumnSpan="2"/>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Управление двигателем" 
                               FontWeight="Bold" FontSize="35"/>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <new_controls:SquareGauge x:Name="engine_pos_rack_injection_ind" Grid.Row="0" 
                                                  Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Положение рейки ТНВД" 
                                   FontWeight="Bold" FontSize="20"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <new_controls:SimpleGauge x:Name="engine_load_na_curr_ind" Grid.Row="0" Grid.Column="0" 
                                                  Margin="10" MinValue="-125" MaxValue="125" IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Нагрузка на текущих оборотах" 
                                   FontWeight="Bold" FontSize="14"/>

                        <new_controls:SimpleGauge x:Name="engine_freq_rot_crank_ind" Grid.Row="0" Grid.Column="1" 
                                                  Margin="10" MinValue="0" MaxValue="2000" MinorTicks="7" LableFontSize="7"
                                                  RedZoneLow="600" YellowZoneHigh="1600" RedZoneHigh="1800"
                                                  IsSignVisible="True"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Частота вращения коленчатого вала дизеля" 
                                   FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <new_controls:RollingCounter x:Name="engine_obschee_cons_fuel_ind" Grid.Column="0" 
                                                 NumbersCount="7" HorizontalAlignment="Center" Margin="1"
                                                 SensorName="Общее использование топлива, л"/>
                    <new_controls:RollingCounter x:Name="engine_tot_mile_ind" Grid.Column="1" 
                                                 NumbersCount="7" HorizontalAlignment="Center" Margin="1"
                                                 SensorName="Общий пробег, км"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <new_controls:Thermometer x:Name="engine_temp_air_vo_ind" Grid.Row="0" Grid.Column="0" Margin="5"
                                              MinValue="-40" MaxValue="100" MajorTicks="15" MinorTicks="1"
                                              YellowZoneHigh="75" RedZoneHigh="95"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Температура воздуха во впускном коллекторе, °С" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontWeight="Bold"/>

                    <new_controls:Thermometer x:Name="engine_temp_cool_ind" Grid.Row="0" Grid.Column="1" Margin="5"
                                              MinValue="0" MaxValue="120" MajorTicks="13" MinorTicks="2"
                                              YellowZoneHigh="105" RedZoneHigh="110" RedZoneLow="8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Температура охлаждающей жидкости, °С" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontWeight="Bold"/>

                    <new_controls:Thermometer x:Name="engine_temp_oil_ind" Grid.Row="0" Grid.Column="2" Margin="5"
                                              MinValue="0" MaxValue="120" MajorTicks="13" MinorTicks="2"
                                              YellowZoneHigh="85" RedZoneHigh="90" RedZoneLow="8"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Температура масла, °С" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontWeight="Bold"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <new_controls:ColumnGauge x:Name="engine_press_air_vo_ind" Grid.Row="0" Grid.Column="0" Width="70"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" LabelSide="Right" 
                                                  MinValue="0" MaxValue="5" MajorTicks="6" MinorTicks="9"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Давление воздуха во впускном коллекторе, кг/см²" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontWeight="Bold"/>

                        <new_controls:ColumnGauge x:Name="engine_press_oil_ind" Grid.Row="0" Grid.Column="1" Width="70"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  MinValue="0" MaxValue="20" MajorTicks="11"
                                                  YellowZoneLow="0.6" RedZoneLow="0.5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Давление масла, кг/см²" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontWeight="Bold"/>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <new_controls:DiscreteIndicator x:Name="engine_rl_pwr_dsl_ind" Grid.Row="0"
                                                        LabelText="Реле питания дизеля" Height="40" FontSize="10"/>
                        <new_controls:DiscreteIndicator x:Name="engine_rl_startera_ind" Grid.Row="1"
                                                        LabelText="Реле стартера" Height="40" FontSize="10"/>
                        <new_controls:DiscreteIndicator x:Name="engine_rl_fuel_pump_ind" Grid.Row="2"
                                                        LabelText="Реле топливного насоса" Height="40" FontSize="10"/>
                        <new_controls:DiscreteIndicator x:Name="engine_rl_stop_dsl_ind" Grid.Row="3"
                                                        LabelText="Реле остановки дизеля" Height="40" FontSize="10"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <new_controls:DiscreteIndicator x:Name="engine_btn_start_dsl_ind" Grid.Column="0" Grid.Row="0" 
                                                    Height="40" LabelText="Кнопка «Пуск дизеля»"/>
                    <new_controls:DiscreteIndicator x:Name="engine_btn_stop_dsl_ind" Grid.Column="0" Grid.Row="1" 
                                                    Height="40" LabelText="Кнопка «Стоп дизеля»"/>
                    <new_controls:DiscreteIndicator x:Name="engine_flag_end_puska_ind" Grid.Column="1" Grid.Row="0" 
                                                    Height="40" LabelText="Признак окончания пуска дизеля"/>
                    <new_controls:DiscreteIndicator x:Name="engine_ena_na_start_ind" Grid.Column="1" Grid.Row="1" 
                                                    Height="40" LabelText="Разрешение на запуск компрессора"/>
                </Grid>
            </Grid>
        </Grid>

        <Button x:Name="MenuToggleButton" Width="30" Height="100" BorderThickness="1" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="15" Margin="0,60,0,0" 
                Click="MenuToggleButton_Click">
            <Button.RenderTransform>
                <TranslateTransform x:Name="ButtonTransform" X="0"/>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10,0,0,10">
                        <ContentPresenter HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center" 
                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="TextTransform" Angle="180"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Button>

        <Grid x:Name="SideMenu" Width="750" Background="#EEE" HorizontalAlignment="Right"
              VerticalAlignment="Stretch" Panel.ZIndex="10" RenderTransformOrigin="1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="201*"/>
            </Grid.RowDefinitions>

            <Grid.RenderTransform>
                <TranslateTransform x:Name="MenuTransform" X="750"/>
            </Grid.RenderTransform>
            <ContentControl x:Name="PanelContent" Grid.RowSpan="2"/>
        </Grid>
    </Grid>
</UserControl>