<UserControl x:Class="TrainBSM_v2.AppAppearance.AuxiliaryAndLightningFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrainBSM_v2.AppAppearance"
             xmlns:new_controls="clr-namespace:TrainBSM_v2.AppAppearance.NewControls"
             mc:Ignorable="d" 
             d:DesignHeight="723" d:DesignWidth="1008">
    <Grid x:Name="MainGrid" Background="#FFE8E8E8" Margin="8" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Вспомогательное и освещение" 
                   FontWeight="Bold" FontSize="40"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="5" Background="DarkGray" Margin="10">
                <Grid Margin="10" Background="DarkGray">
                    <Image Source="/AppAppearance/Assets/auxiliary_and_lightning/auxiliary.png" Width="220" Opacity="0.12"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <new_controls:DiscreteIndicator x:Name="aux_podacha_sand" Grid.Row="0" 
                                            Margin="5" LabelMargin="30" LabelText="Подача песка"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="aux_valv_sand" Grid.Row="1" 
                                            InactiveColor="DarkBlue" ActiveColor="Blue"
                                            Margin="5" LabelMargin="30" LabelText="Вентили подачи песка" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <new_controls:DiscreteIndicator x:Name="aux_horn" Grid.Row="2" 
                                            Margin="5" LabelMargin="30" LabelText="Тифон" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="Тифон" Grid.Row="3" 
                                            Margin="5" LabelMargin="30" LabelText="Свисток" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="aux_btn_auto_coupler_fr" Grid.Row="4" 
                                            Margin="5" LabelMargin="30" LabelText="Кнопка «Автосцепка передняя»" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="aux_btn_auto_coupler_rr" Grid.Row="5" 
                                            Margin="5" LabelMargin="30" LabelText="Кнопка «Автосцепка задняя»" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="aux_auto_coupler_fr" Grid.Row="6" 
                                            Margin="5" LabelMargin="30" LabelText="Автосцепка передняя" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="aux_auto_coupler_rr" Grid.Row="7" 
                                            Margin="5" LabelMargin="30" LabelText="Автосцепка задняя" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="5" Background="DarkGray" Margin="10">
                <Grid Margin="10" Background="DarkGray">
                    <Image Source="/AppAppearance/Assets/auxiliary_and_lightning/lightning.png" Width="220" Opacity="0.12"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <new_controls:DiscreteIndicator x:Name="light_lamp_fr_l_red" Grid.Column="0" Grid.Row="0"
                                            ActiveColor="Red" InactiveColor="DarkRed"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь передний левый красный" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_fr_l_white" Grid.Column="0" Grid.Row="1"
                                            ActiveColor="LightGray" InactiveColor="Gray"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь передний левый белый" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_fr_r_red" Grid.Column="1" Grid.Row="0"
                                            ActiveColor="Red" InactiveColor="DarkRed"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь передний правый красный" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_fr_r_white" Grid.Column="1" Grid.Row="1"
                                            ActiveColor="LightGray" InactiveColor="Gray"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь передний правый белый" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>

                        <new_controls:DiscreteIndicator x:Name="light_lamp_rr_l_red" Grid.Column="0" Grid.Row="2"
                                            ActiveColor="Red" InactiveColor="DarkRed"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь задний левый красный" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_rr_l_white" Grid.Column="0" Grid.Row="3"
                                            ActiveColor="LightGray" InactiveColor="Gray"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь задний левый белый" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_rr_r_red" Grid.Column="1" Grid.Row="2"
                                            ActiveColor="Red" InactiveColor="DarkRed"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь задний правый красный" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_lamp_rr_r_white" Grid.Column="1" Grid.Row="3"
                                            ActiveColor="LightGray" InactiveColor="Gray"
                                            Margin="10" LabelMargin="30" LabelText="Сигнальный фонарь задний правый белый" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>

                        <new_controls:DiscreteIndicator x:Name="light_hl_fr_lo" Grid.Column="0" Grid.Row="4"
                                            ActiveColor="Gold" InactiveColor="DarkGoldenrod"
                                            Margin="10" LabelMargin="30" LabelText="Прожектор передний тускло" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_hl_fr_hi" Grid.Column="1" Grid.Row="4"
                                            ActiveColor="Gold" InactiveColor="DarkGoldenrod"
                                            Margin="10" LabelMargin="30" LabelText="Прожектор передний ярко" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_hl_rr_lo" Grid.Column="0" Grid.Row="5"
                                            ActiveColor="Gold" InactiveColor="DarkGoldenrod"
                                            Margin="10" LabelMargin="30" LabelText="Прожектор задний тускло" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                        <new_controls:DiscreteIndicator x:Name="light_hl_rr_hi" Grid.Column="1" Grid.Row="5"
                                            ActiveColor="Gold" InactiveColor="DarkGoldenrod"
                                            Margin="10" LabelMargin="30" LabelText="Прожектор задний ярко" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsClickable="True"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
